{
    "name": "sytxlabs/dockphp",
    "description": "Framework-agnostic PHP client for the Docker Engine API over the Unix socket",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/SytxLabs/dockphp",
    "support": {
        "issues": "https://github.com/SytxLabs/dockphp/issues",
        "source": "https://github.com/SytxLabs/dockphp"
    },
    "keywords": ["docker", "docker-engine-api", "unix-socket", "containers"],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Sytxlabs\\Dockphp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sytxlabs\\Dockphp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "stan": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
